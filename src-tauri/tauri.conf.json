{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "kaja-ci",
  "version": "1.0.0",
  "identifier": "com.kaja.ci",
  "build": {
    "beforeDevCommand": "npm run build:wasm",
    "devUrl": "http://127.0.0.1:2003",
    "beforeBuildCommand": "npm run build:wasm",
    "frontendDist": "../frontend/pkg"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "tauri-app",
        "width": 1203,
        "height": 761,
        "url": "http://127.0.0.1:2003"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
